# Copy to .env and fill in values. Do not commit real secrets.

# DeepSeek LLM（默认供应商；OpenAI 兼容协议）
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/profile_rec

# Auth
JWT_SECRET=dev-secret-change-me

# Feature flags
MOCK_WECOM=true
MOCK_LLM=true

# Seed admin (used by POST /api/v1/mock/seed/demo)
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=admin123

# WeCom（test / prod）
WECOM_CORP_ID=
WECOM_SECRET=
